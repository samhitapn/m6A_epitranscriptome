########## 2. REPLICATE CORRELATION
ip_adj <- extractIP(
  merip,
  normalized = TRUE,
  adjusted = TRUE
)
ip_adj_f <- ip_adj[rownames(ip_adj) %in% plot_data_m$Bins, , drop = FALSE]

# Log transformation
log_ip <- as.matrix(log2(ip_adj_f + 1))
colnames(log_ip) <- unique(plot_data_m[,Sample1])

# Pearson correlation
cor_matrix <- cor(
  log_ip,
  method = "pearson",
  use = "pairwise.complete.obs"
)

# Correlation heatmap
pdf(
  "/radarQC/Replicate_correlation_heatmap.pdf",
  width = 8,
  height = 7
)

pheatmap(
  cor_matrix,
  display_numbers = TRUE,
  number_format = "%.2f",
  clustering_distance_rows = "correlation",
  clustering_distance_cols = "correlation",
  main = "Biological replicate correlation"
)

dev.off()

########## 3. FERIP
# Convert RADAR peak coordinates to GRanges
peak_gr <- GRanges(
  seqnames = results_dmg_lnc$chr,
  ranges = IRanges(
    start = results_dmg_lnc$start,
    end = results_dmg_lnc$end
  ),
  strand = results_dmg_lnc$strand
)

# Reduce overlapping peaks
peak_gr <- reduce(peak_gr)

# Obtain BAM files
input_bams <- Input.files(merip)
ip_bams <- IP.files(merip)

bam_files <- c(input_bams, ip_bams)

library_names <- c(
  paste0(samplenames(merip), "_INPUT"),
  paste0(samplenames(merip), "_IP")
)

# Calculate reads overlapping peaks
frip_results <- lapply(seq_along(bam_files), function(i) {

  bam <- BamFile(bam_files[i])

  # Count reads overlapping peaks
  peak_counts <- summarizeOverlaps(
    features = peak_gr,
    reads = bam,
    mode = "Union",
    singleEnd = TRUE,
    fragments = FALSE,
    ignore.strand = TRUE
  )

  reads_in_peaks <- sum(
    assay(peak_counts),
    na.rm = TRUE
  )

  # Total mapped reads
  total_reads <- countBam(bam)$records

  data.frame(
    Sample = library_names[i],
    Reads_in_peaks = reads_in_peaks,
    Total_reads = total_reads,
    FRiP = reads_in_peaks / total_reads
  )
})

frip_df <- bind_rows(frip_results)

pdf(
  "/radarQC/frip.pdf",
  width = 8,
  height = 7
)
setDT(frip_df)
frip_dt <- frip_df[
