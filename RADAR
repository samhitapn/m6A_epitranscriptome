  gtf = "gencode.vM36.annotation.gtf", 
  fragmentLength = 150,
  bamFolder="/results/miceBams_all/",
  outputDir="/radar_results/",
  modification = "m6A",
  binSize = 50,
  strandToKeep = "opposite",
  paired = TRUE,
  threads = 60,
  saveOutput = T
)

########### RADAR RESULT ANALYSIS
